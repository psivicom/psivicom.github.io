# ==============================================================================
# PSIVI.COM Open Science Domain-Separated Repository Attributes
# Target: Enforce Machine-Readability & Prevent Orphan Artifact Mapping
# ==============================================================================

# Global Default: Set standard line endings for multi-platform local environments
* text=auto eol=lf

# ------------------------------------------------------------------------------
# 1. Legal & Attribution Foundations (Universal Metadata Mapping)
# ------------------------------------------------------------------------------
LICENSE-EUPL-1.2.txt  gitlab-language=text open-science-licensing="software-root"
LICENSE-CC-BY-SA-4.0.md gitlab-language=markdown open-science-licensing="data-root"
NOTICE.md             gitlab-language=markdown open-science-licensing="attribution"
CITATION.cff          gitlab-language=yaml open-science-metadata="citation"
codemeta.json         gitlab-language=json open-science-metadata="codemeta"

# ------------------------------------------------------------------------------
# 2. Software & Executable Pipelines (EUPL 1.2 Territory)
# ------------------------------------------------------------------------------
*.go                  linguist-documentation=false open-science-license="EUPL-1.2"
*.py                  linguist-documentation=false open-science-license="EUPL-1.2"
*.sh                  linguist-documentation=false open-science-license="EUPL-1.2"
*.js                  linguist-documentation=false open-science-license="EUPL-1.2"
_config.yml           linguist-vendored=false open-science-config="jekyll"

# ------------------------------------------------------------------------------
# 3. Data Systems & Documentation Arrays (CC BY-SA 4.0 Territory)
# ------------------------------------------------------------------------------
docs/**/*.md          linguist-documentation=true open-science-license="CC-BY-SA-4.0"
data/**/*.csv         linguist-data=true open-science-license="CC-BY-SA-4.0"
data/**/*.json        linguist-data=true open-science-license="CC-BY-SA-4.0"

# ------------------------------------------------------------------------------
# 4. Binary Assets & Telemetry Feeds
# ------------------------------------------------------------------------------
*.png                 binary open-science-asset="figure"
*.jpg                 binary open-science-asset="figure"
*.jpeg                binary open-science-asset="figure"
*.tiff                binary open-science-asset="eo-raster"
